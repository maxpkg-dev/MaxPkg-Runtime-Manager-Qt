/* MaxPkg Manager stylesheet. @tokens are replaced by colors of the active Manager theme
   (assets/themes/manager/*.ini). Sizes follow the HTML Manager 1.2.0 (ui/manager/manager.css). */

/* Base font: a bare type selector (lowest specificity), so every #Id rule below can change size and color.
   "#ManagerRoot QWidget" would outrank "#WelcomeTitle" and force 13 px everywhere. The sheet is applied
   only to our own windows, so QWidget does not leak into 3ds Max. */
QWidget {
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    color: @textPrimary;
}

QToolTip {
    background: @surfaceTertiary;
    color: @textStrong;
    border: 1px solid @textDisabled;
    padding: 4px 6px;
}

/* ---------- own window chrome (same behaviour as TerraScoop) ---------- */
#TitleBar, #MiniBar { background: transparent; border: none; }
#HeaderDivider { background: @borderDefault; border: none; }
#WindowTitle { color: @accent; font-weight: bold; font-size: 10pt; }
QPushButton#ChromeButton { min-width: 28px; max-width: 28px; min-height: 28px; max-height: 28px;
    border: 1px solid transparent; border-radius: 14px; background: transparent; padding: 0;
}
QPushButton#ChromeButton:hover { background: @surfaceHover; border-color: @borderDefault; }
/* Close turns red on hover with PivotLandia's colours (the same in every theme), behind a light glass edge. */
QPushButton#ChromeButton[close="true"]:hover { background: #9f3636; border-color: rgba(230, 120, 120, 150); }
QPushButton#ChromeButton[close="true"]:pressed { background: #842d2d; border-color: rgba(230, 120, 120, 110); }
/* The collapsed bar's name fills the row like the close button next to it (28 px, fully rounded). */
QPushButton#MiniTitle {
    background: transparent; border: none; border-radius: 13px; color: @accent; font-weight: bold;
    font-size: 10pt; padding: 0 12px; min-height: 28px; max-height: 28px; text-align: left;
}
QPushButton#MiniTitle:hover { background: @surfaceHover; }
QPushButton#MiniTitle:pressed { background: @borderDefault; }

/* ---------- frame ---------- */
#Header { border-bottom: 1px solid @borderSoft; background: transparent; }
#BrandTitle { color: @textStrong; font-size: 16px; font-weight: bold; }
#BrandSubtitle, #Muted, QLabel[muted="true"] { color: @textMuted; font-size: 11px; }
#TabBar { border-bottom: 1px solid @borderSoft; background: transparent; }
#PageToolbar { border-bottom: 1px solid @borderSoft; background: transparent; }
#StatusBar { border-top: 1px solid @borderSoft; background: transparent; }
#StatusBar QLabel { color: @textMuted; font-size: 11px; }
#StatusBar QLabel[tone="success"] { color: @successText; }
#StatusBar QLabel[tone="warning"] { color: @warning; }
#StatusLink { color: @successText; font-size: 11px; border: none; background: transparent; padding: 0 2px; }
#StatusLink:hover { color: @accentHover; }

QScrollArea, QScrollArea > QWidget > QWidget#PageCanvas { background: transparent; border: none; }
/* The thumbnail strip sits on its section: viewport and content stay see-through. */
QScrollArea#ThumbStrip > QWidget, QWidget#ThumbStripContent { background: transparent; }
#PageCanvas { background: transparent; }

/* Thin pill scrollbars: 4 px handle, 6 px while hovered/dragged, fully rounded, no arrows. */
QScrollBar:vertical { background: transparent; width: 10px; margin: 4px 2px 4px 2px; border: none; }
QScrollBar::handle:vertical {
    background: @borderStrong; min-height: 36px; border-radius: 2px; margin: 0 1px 0 1px;
}
QScrollBar:vertical:hover { background: transparent; }
QScrollBar::handle:vertical:hover, QScrollBar::handle:vertical:pressed {
    background: @textDisabled; border-radius: 3px; margin: 0;
}
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px 4px 2px 4px; border: none; }
QScrollBar::handle:horizontal {
    background: @borderStrong; min-width: 36px; border-radius: 2px; margin: 1px 0 1px 0;
}
QScrollBar::handle:horizontal:hover, QScrollBar::handle:horizontal:pressed {
    background: @textDisabled; border-radius: 3px; margin: 0;
}
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; background: transparent; }
QScrollBar::add-page, QScrollBar::sub-page, QScrollBar::up-arrow, QScrollBar::down-arrow { background: transparent; }

/* ---------- tabs ---------- */
#TabButton {
    border: none; border-bottom: 2px solid transparent; background: transparent;
    color: @textMuted; padding: 0 18px; min-height: 41px;
}
#TabButton:hover { color: @textStrong; }
#TabButton:checked { border-bottom-color: @accentHover; color: @textStrong; }
#TabCount { border: 1px solid transparent;
    background: @borderDefault; border-radius: 8px; color: @textPrimary;
    font-size: 10px; padding: 1px 6px; min-width: 8px; min-height: 14px; max-height: 14px;
}
/* Pending updates: the red of the toolbar's update counter. */
#TabCount[alert="true"] { border-color: #dc7777; background: #9f3636; color: #fff4f4; font-weight: bold; }
#DetailsTab {
    border: none; border-bottom: 2px solid transparent; background: transparent;
    color: @textMuted; padding: 0 3px; min-height: 36px; margin-right: 13px;
}
#DetailsTab:hover, #DetailsTab:checked { border-bottom-color: @accent; color: @textStrong; }
#DetailsTabCount { border: 1px solid transparent; background: @surfaceTertiary; border-radius: 7px; font-size: 10px; padding: 0 6px; }

/* ---------- buttons ---------- */
QPushButton[variant] {
    border: 1px solid @textDisabled; border-radius: 10px; background: @borderSoft;
    color: @textPrimary; padding: 6px 11px; min-height: 18px;
}
QPushButton, QComboBox, QLineEdit { outline: none; }
QPushButton[variant]:hover, QPushButton[variant]:focus {
    border-color: @accentHover; background: @borderStrong; color: @textStrong;
}
QPushButton[variant]:disabled { color: @textDisabled; border-color: @borderDefault; background: @surfaceDisabled; }
QPushButton[variant="primary"] { border-color: @borderFocus; background: @accentActive; color: @textStrong; }
QPushButton[variant="primary"]:hover { border-color: @accentHover; background: @selectionBlueSurface; }
QPushButton[variant="success"] { border-color: rgba(40, 167, 69, 204); background: rgba(40, 167, 69, 56); color: @textStrong; }
QPushButton[variant="success"]:hover { border-color: #34c759; background: rgba(40, 167, 69, 92); }
QPushButton[variant="danger"] { border-color: @dangerBorder; background: @dangerSurface; color: @dangerText; }
QPushButton[variant="danger"]:hover { border-color: @danger; background: @dangerActive; color: @dangerText; }
QPushButton[variant="installed"] { border-color: @successBorder; background: @successSurface; color: @successText; }
QPushButton[compact="true"] { padding: 5px 9px; }
QPushButton[iconOnly="true"] { padding: 6px; min-width: 18px; max-width: 18px; }
QPushButton[iconOnly="true"][variant] { min-width: 18px; }
/* Small copy icon inside text rows (Package ID, the MaxPkg link): no frame until hovered. */
QPushButton#CopyButton { border: 1px solid transparent; border-radius: 5px; background: transparent; padding: 0; }
QPushButton#CopyButton:hover { background: @surfaceHover; border-color: @borderDefault; }

#TextLink { border: none; background: transparent; color: @textMuted; padding: 2px 0; }
#TextLink:hover { color: @accentHover; }

/* ---------- fields ---------- */
QLineEdit#SearchInput, QLineEdit[field="true"] {
    border: 1px solid @borderStrong; border-radius: 10px; background: @surfaceGlass;
    color: @textPrimary; padding: 6px 10px; min-height: 18px;
    selection-background-color: @selectionBlue; selection-color: @selectionBlueText;
}
QLineEdit#SearchInput { padding-left: 32px; }
QLineEdit#SearchInput:focus, QLineEdit[field="true"]:focus { border-color: @accentHover; background: @surfaceGlassHover; }

QComboBox[field="true"] {
    border: 1px solid @borderStrong; border-radius: 10px; background: @surfaceGlass;
    color: @textPrimary; padding: 6px 30px 6px 10px; min-height: 18px;
}
QComboBox[field="true"]:hover, QComboBox[field="true"]:focus, QComboBox[field="true"]:on { border-color: @accentHover; }
QComboBox[field="true"][active="true"] { border-color: @borderFocus; background: @accentActive; color: @textStrong; }
QComboBox[field="true"]::drop-down { border: none; width: 28px; }
QComboBox[field="true"]::down-arrow { image: none; width: 0; height: 0; }
QComboBox QAbstractItemView {
    border: 1px solid @textDisabled; border-radius: 8px; background: @surfaceTertiary;
    color: @textPrimary; padding: 4px; outline: none;
    selection-background-color: @borderStrong; selection-color: @textStrong;
}
QComboBox QAbstractItemView::item { min-height: 28px; padding: 0 8px; border-radius: 8px; }

#ClearButton { border: none; background: transparent; border-radius: 8px; padding: 4px; }
#ClearButton:hover { background: @borderStrong; }

/* ---------- pills and badges ---------- */
QLabel[badge] {
    border: 1px solid @borderSoft; border-radius: 10px; background: @surfaceGlassHover;
    color: @textSecondary; font-size: 11px; padding: 2px 8px; min-height: 15px; max-height: 15px;
}
QLabel[badge="warning"] { border-color: @warningBorder; color: @warning; }
QLabel[badge="success"] { border-color: @successBorder; color: @successText; background: @successSurface; }
QLabel[badge="danger"] { border-color: @dangerBorder; color: @dangerText; }
QLabel[badge="changed"] { border-color: @changedBorder; color: @changed; background: @changedSurface; }
QLabel[badge="added"] { border-color: @successBorder; color: @successText; background: @successSurface; }
QLabel[badge="fixed"] { border-color: @warningBorder; color: @warningText; background: @warningSurface; }
QLabel[badge="improved"] { border-color: @borderFocus; color: @accentText; background: @accentActive; }
QLabel[badge="removed"] { border-color: @dangerBorder; color: @dangerText; background: @dangerSurface; }
QPushButton#PurchasePill {
    border: 1px solid @successBorder; border-radius: 10px; background: @successSurface;
    color: @successText; font-size: 11px; padding: 2px 8px 2px 6px; min-height: 15px; max-height: 15px;
}
QPushButton#PurchasePill:hover { border-color: @success; }

QPushButton#CollectionPill {
    border: 1px solid @borderStrong; border-radius: 16px; background: @surfaceRaised;
    color: #ffffff; font-size: 12px; padding: 0 10px; min-height: 30px;
}

/* ---------- cards and panels ---------- */
#Card {
    border: 1px solid @borderSoft; border-radius: 16px; background: @surfaceGlass;
}
#Card:hover { border-color: @borderDefault; background: @surfaceGlassHover; }
#Card[dropTarget="true"] { border: 1px dashed @accentHover; }
#CardTitle { color: @textStrong; font-size: 14px; font-weight: bold; }
#CardMeta { color: @textMuted; font-size: 11px; }
#CardDescription { color: @textSecondary; font-size: 12px; }
#CardStats { color: @textMuted; font-size: 11px; }
#PackageIcon { border: 1px solid @borderStrong; border-radius: 10px; background: @surfaceDisabled; }
#PackageIcon[large="true"] { border-color: @borderSoft; border-radius: 12px; background: @backgroundWindow; }
#Initials { color: @textStrong; font-weight: bold; }

#Panel, #DetailsHero, #DetailsSection {
    border: 1px solid @borderSoft; border-radius: 16px; background: @surfaceGlass;
}
#SidebarPanel { border: 1px solid @borderStrong; border-radius: 16px; background: @surfaceGlass; }
#SectionTitle { color: @textMuted; font-size: 11px; font-weight: bold; letter-spacing: 0.7px; }
#SectionLink { color: @successText; font-size: 11px; border: none; background: transparent; padding: 0 2px; }
#SectionLink:hover { color: @accentHover; }
#SidebarTitle { color: @accentText; font-size: 11px; font-weight: bold; letter-spacing: 0.7px; }
#StatePanel { border: 1px solid @borderDefault; border-radius: 16px; background: @surfaceGlass; }
#StateTitle { color: @textStrong; font-size: 18px; font-weight: bold; }
#StateText { color: @textMuted; }
#Summary { color: @textMuted; }

QPushButton#CategoryItem {
    border: 1px solid transparent; border-radius: 10px; background: transparent;
    color: @textSecondary; text-align: left; padding: 8px 10px; font-size: 12px;
}
QPushButton#CategoryItem:hover { background: @surfaceHover; color: @textStrong; }
QPushButton#CategoryItem:checked { border-color: @successBorder; background: @successSurface; color: @textStrong; }

/* ---------- details ---------- */
#DetailsName { color: @textStrong; font-size: 18px; font-weight: bold; }
#DetailsNavigation { border-bottom: 1px solid @borderSoft; }
#Breadcrumb { color: @textMuted; font-size: 12px; }
#BreadcrumbCurrent { color: @textStrong; font-size: 12px; font-weight: bold; }
#InfoKey { color: @textMuted; font-size: 11px; }
#InfoValue { color: @textPrimary; font-size: 11px; font-family: Consolas, "Courier New", monospace; }
#InfoRow { border-bottom: 1px solid @borderSoft; }
/* Purchase notice: a calm card, never a warning. Free = soft success tint, paid = soft accent tint. */
#PurchaseNotice { border: 1px solid @borderSoft; border-radius: 16px; background: @surfaceGlass; }
#PurchaseNotice[kind="free"] {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 @successSurface, stop: 1 @surfaceGlass);
}
#PurchaseNotice[kind="paid"] {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 @accentActive, stop: 1 @surfaceGlass);
}
#NoticeBadge { border: 1px solid @successBorder; border-radius: 18px; background: @successSurface; }
#NoticeBadge[kind="paid"] { border-color: @borderFocus; background: @accentActive; }
#NoticeTitle { color: @textStrong; font-size: 13px; font-weight: bold; }
#NoticeText { color: @textSecondary; font-size: 12px; }
#PurchaseNotice QLabel { color: @textSecondary; }
QTextBrowser#Description { background: transparent; border: none; color: @textSecondary; }
#ChangelogVersion { color: @textStrong; font-weight: bold; }
#ChangelogDate { color: @textMuted; font-size: 11px; }
#ScreenshotMain { border: 1px solid @borderSoft; border-radius: 8px; background: @backgroundDeep; }
#LightboxSlides { border: none; background: transparent; }
QPushButton#Thumb { border: 1px solid @borderSoft; border-radius: 6px; background: @surfaceSecondary; padding: 2px; }
QPushButton#Thumb:checked { border-color: @accentHover; }
QPushButton#GalleryNav { border: 1px solid @borderStrong; border-radius: 16px; background: @overlay; padding: 0;
                         min-width: 32px; max-width: 32px; min-height: 32px; max-height: 32px; }
QPushButton#GalleryNav[large="true"] { border-radius: 20px; min-width: 40px; max-width: 40px; min-height: 40px; max-height: 40px; }
#GalleryCounter { border: 1px solid @borderStrong; border-radius: 10px; background: @overlay; color: @textStrong;
                  font-size: 11px; padding: 2px 8px; min-height: 15px; max-height: 15px; }
QPushButton#GalleryNav:hover { border-color: @accentHover; }

/* ---------- menus ---------- */
QMenu#ContextMenu {
    border: 1px solid @textDisabled; border-radius: 10px; background: @surfaceTertiary; padding: 4px;
}
/* Measured in Max: the icon starts 12 px inside the highlight, the text 10 px after the icon
   (widgets.add_danger_action paints its red row at the same offsets). */
QMenu#ContextMenu::item { color: @textPrimary; padding: 7px 14px 7px 17px; border-radius: 7px; min-width: 150px; }
QMenu#ContextMenu::item:selected { background: @borderStrong; color: @textStrong; }
QMenu#ContextMenu::item:disabled { color: @textDisabled; }
QMenu#ContextMenu::separator { height: 1px; background: @borderDefault; margin: 4px 6px; }
QMenu#ContextMenu::icon { padding-left: 18px; }

/* ---------- overlays ---------- */
#BusyShade { background: @backgroundOverlay; }
/* Package operations: a frosted backdrop (WorkShade paints a blurred snapshot) and a glass card that
   BusyCard paints itself (nearly opaque theme surfaces, bright top edge). */
#BusyCard { background: transparent; border: none; }
#BusyTitle { color: @textStrong; font-size: 14px; font-weight: bold; }
#BusyHint { color: @textMuted; font-size: 12px; }
/* Toasts paint their own glass card (manager_window.Toast); only the texts and the close button are styled here. */
#Toast { background: transparent; border: none; }
#ToastTitle { color: @textStrong; font-size: 13px; font-weight: bold; }
#ToastBody { color: @textSecondary; font-size: 12px; }
QPushButton#ToastClose { border: none; border-radius: 10px; background: transparent; padding: 0;
                         min-width: 22px; max-width: 22px; min-height: 22px; max-height: 22px; }
QPushButton#ToastClose:hover { background: @surfaceHover; }
#ToastText { color: @textStrong; }

/* ---------- settings ---------- */
#ModalShade { background: @overlay; }
#SettingsBody { background: transparent; border: none; }
#Modal { border: 1px solid @textDisabled; border-radius: 7px; background: @surfacePrimary; }
#ModalHeader { border-bottom: 1px solid @borderDefault; }
#ModalTitle { color: @textStrong; font-size: 18px; font-weight: bold; }
#SettingsNavigation { border-right: 1px solid @borderDefault; background: @surfaceSecondary; border-bottom-left-radius: 7px; }
QPushButton#SettingsNavButton {
    border: none; border-radius: 10px; background: transparent; color: @textSecondary;
    text-align: left; padding: 0 10px 0 12px; min-height: 34px;
}
QPushButton#SettingsNavButton:hover, QPushButton#SettingsNavButton:checked { background: @surfaceActive; color: @textStrong; }
QPushButton#SettingsNavButton[danger="true"] { color: @dangerText; }
QPushButton#SettingsNavButton[danger="true"]:checked { background: @dangerSurface; }
#PageTitle { color: @textStrong; font-size: 14px; font-weight: bold; }
#SupportText { color: @textSecondary; }
#FieldLabel { color: @textPrimary; }
#ConfigLabel { color: @textStrong; font-size: 12px; font-weight: bold; }
#ConfigPanel, #PreviewPanel { border: 1px solid @borderDefault; border-radius: 12px; background: @surfaceSecondary; }
#PreviewStage { border: 1px solid @borderSoft; border-radius: 8px; background: @backgroundWindow; }
#Notice { border: 1px solid @borderSoft; border-radius: 12px; background: @surfaceSecondary; }
#DangerNotice { border: 1px solid @dangerBorder; border-radius: 12px; background: @dangerSurface; }
QPushButton#Segment {
    border: 1px solid @borderDefault; border-radius: 9px; background: @surfaceSecondary;
    color: @textSecondary; font-size: 11px; font-weight: bold; padding: 5px 10px; min-height: 19px;
}
QPushButton#Segment:hover { border-color: @borderStrong; background: @surfaceHover; color: @textStrong; }
QPushButton#Segment:checked { border-color: @borderFocus; background: @accentActive; color: @textStrong; }
QPushButton#Segment:disabled { color: @textDisabled; }

/* ---------- onboarding (welcome) window ---------- */
#WelcomeHeader { background: transparent; border-bottom: 1px solid @borderSoft; }
#WelcomeFooter { background: transparent; border-top: 1px solid @borderSoft; }
#WelcomeBrand { color: @textStrong; font-size: 14px; font-weight: bold; }
#WelcomeHeroTile { border: 1px solid @borderFocus; border-radius: 28px; background: @accentActive; }
#WelcomeEyebrow { color: @accentText; font-size: 11px; font-weight: bold; letter-spacing: 1.5px; }
#WelcomeTitle { color: @textStrong; font-size: 24px; font-weight: bold; }
#WelcomeText { color: @textSecondary; font-size: 14px; }
#WelcomeInstalled { border: 1px solid @successBorder; border-radius: 11px; min-height: 17px; max-height: 17px; background: @successSurface;
                    color: @successText; font-size: 11px; font-weight: bold; padding: 3px 10px; }
#WelcomeHint { color: @textMuted; font-size: 12px; }
#WelcomeError { color: @danger; border: 1px solid @danger; border-radius: 12px; padding: 12px; }
